# Copy to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------------
# Database (Prisma / SQLite)
# ---------------------------------------------------------------------------
# SQLite for local development; path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Required. Generate with `npx auth secret` or `openssl rand -base64 32`.
# TODO: fill real values
AUTH_SECRET="..."

# Google OAuth (optional). Google sign-in is disabled if either is blank.
# TODO: fill real values
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# PayPal (used in later phases)
# ---------------------------------------------------------------------------
# TODO: fill real values
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Site / SEO
# ---------------------------------------------------------------------------
# Canonical public base URL (no trailing slash). Used for metadataBase,
# Open Graph URLs, the sitemap, and robots.txt. Set per environment.
# TODO: set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL="https://www.rccgcovenantembassy.org"

# Private redesign review: admins are allowed. Optionally allow existing member IDs.
# This grants review access only; do not promote reviewers to administrator.
REDESIGN_REVIEWER_USER_IDS=""

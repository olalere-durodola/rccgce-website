# Copy to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
# PostgreSQL is used in BOTH local development and production.
#
# Local: run a Postgres in Docker (see README / docs/DEPLOY-RAILWAY.md):
#   docker run --name rccgce-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=rccgce -p 5432:5432 -d postgres:16
# then apply migrations with `npx prisma migrate deploy` and `npm run seed`.
#
# Production (Railway): Postgres is provisioned by Railway and injected as
# DATABASE_URL — reference it in the web service as ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rccgce?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Required. Generate with `npx auth secret` or `openssl rand -base64 32`.
# TODO: fill real values
AUTH_SECRET="..."

# Trust proxy/host headers. REQUIRED behind a reverse proxy on non-Vercel hosts
# such as Railway, otherwise NextAuth v5 throws UntrustedHost. Defaults to true
# in code (trustHost: true), but leaving this set is harmless and explicit.
AUTH_TRUST_HOST="true"

# Canonical auth URL. NextAuth v5 infers this from request headers when
# trustHost is enabled; set it explicitly to your public URL if you hit
# callback/redirect issues in production (NEXTAUTH_URL is the legacy alias).
# AUTH_URL="https://your-app.up.railway.app"

# Google OAuth (optional). Google sign-in is disabled if either is blank.
# TODO: fill real values
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------
# TODO: fill real values. Use sandbox creds + sandbox API base for testing,
# then switch to live (PAYPAL_API_BASE="https://api-m.paypal.com") at launch.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Recurring giving (optional). One billing plan id per fund+preset-amount, named
# PAYPAL_PLAN_<FUND>_<AMOUNT_IN_DOLLARS>. Unset => recurring shows a friendly
# "not configured" message; one-time giving still works. Examples:
# PAYPAL_PLAN_TITHE_50=""
# PAYPAL_PLAN_OFFERING_25=""

# ---------------------------------------------------------------------------
# Site / SEO
# ---------------------------------------------------------------------------
# Canonical public base URL (no trailing slash). Used for metadataBase,
# Open Graph URLs, the sitemap, and robots.txt. Set per environment.
# On Railway, set this to your public Railway URL or custom domain.
# TODO: set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL="https://www.rccgcovenantembassy.org"

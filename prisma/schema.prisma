// RCCG Covenant Embassy — Prisma schema (PostgreSQL)
// NOTE: "Enum-like" columns are plain String fields with documented allowed
// values (validated in app code via Zod), kept as Strings for flexibility and
// to match the original SQLite design — they are not native Postgres enums.
//
// Both production (Railway managed Postgres) and local development use
// PostgreSQL. See docs/DEPLOY-RAILWAY.md and the README for the local Docker
// Postgres one-liner. The connection URL is read from prisma.config.ts /
// the DATABASE_URL env var.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & Auth.js (next-auth / @auth/prisma-adapter) models
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  // Nullable: set for Credentials login, null for OAuth-only accounts.
  hashedPassword String?
  image          String?
  // Allowed values: "MEMBER" | "ADMIN"
  role           String    @default("MEMBER")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  donations     Donation[]
  subscriptions Subscription[]
  savedSermons  SavedSermon[]
  blogPosts     BlogPost[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Content: Series / Sermons / Events / Ministries / Blog
// ---------------------------------------------------------------------------

model Series {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  sermons Sermon[]
}

model Sermon {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  speaker      String
  date         DateTime
  scripture    String?
  description  String?
  videoUrl     String?
  audioUrl     String?
  thumbnailUrl String?
  seriesId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  series   Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  savedBy  SavedSermon[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ministry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  summary     String?
  description String?
  imageUrl    String?
  leader      String?
  meetingTime String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String // markdown
  coverImage  String?
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Giving: Donations / Subscriptions
// ---------------------------------------------------------------------------

model Donation {
  id            String   @id @default(cuid())
  userId        String?
  // Stored as integer CENTS (e.g. $25.00 -> 2500) to avoid float drift.
  amount        Int
  currency      String   @default("USD")
  // Allowed values: "Tithe" | "Offering" | "Missions" | "Building"
  fund          String
  paypalOrderId String   @unique
  status        String
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String?
  paypalSubscriptionId String   @unique
  planName             String
  // Stored as integer CENTS (e.g. $25.00 -> 2500) to avoid float drift.
  amount               Int
  // Allowed values: "Tithe" | "Offering" | "Missions" | "Building"
  fund                 String
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Join / misc
// ---------------------------------------------------------------------------

model SavedSermon {
  userId    String
  sermonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@id([userId, sermonId])
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
